# Port the single Node process listens on (client + WS + REST).
PORT=3000

# Where revealed poems are kept. The gallery (/gallery, /poem/:id) reads
# ${DATA_DIR}/poems.jsonl — an append-only file, one poem per line, created on
# the first reveal. Back this directory up and you have backed up every poem;
# delete it and the gallery is empty again.
DATA_DIR=./data

# --- Poem composition -------------------------------------------------------
# Optional. Without a key the deterministic engine composes every poem and the
# app works exactly as before. With one, poems are written by a language model
# that can make the submitted words agree grammatically, with the deterministic
# engine kept as the fallback for any failure.
#
# Get a key at https://openrouter.ai/keys. Server-side only — this variable is
# deliberately NOT prefixed with VITE_, so it is never inlined into the browser
# bundle.
OPENROUTER_API_KEY=

# Any model slug from https://openrouter.ai/models.
# Default: anthropic/claude-sonnet-5 (~$0.002 per poem).
# For noticeably better verse at ~5x the cost: anthropic/claude-fable-5.
# For ~5x cheaper, near-equivalent short verse: google/gemini-2.5-flash.
OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional. The model that writes the queue's clues ("desk" -> "a place where
# one writes"). Clues are a lower bar than a whole poem — one word to one line —
# so a cheaper model is safe here and the deterministic clue covers any miss.
# Unset falls back to OPENROUTER_MODEL, then to OPENROUTER_MODEL's default.
OPENROUTER_CLUE_MODEL=

# How long to wait for the model before falling back to the deterministic poem.
# Players are staring at a "weaving" screen for this long, so keep it short.
OPENROUTER_TIMEOUT_MS=12000

# How long to wait for the clue model before falling back to the deterministic
# clue ("a noun of 4 letters"). The next author is staring at a waiting screen
# for this long, so it is shorter still.
OPENROUTER_CLUE_TIMEOUT_MS=8000

# Optional. Sent to OpenRouter as HTTP-Referer for attribution in their rankings.
PUBLIC_URL=
